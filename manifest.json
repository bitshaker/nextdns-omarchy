{
  "schemaVersion": 1,
  "id": "bitshaker.nextdns-omarchy",
  "name": "NextDNS Control",
  "version": "0.2.3",
  "author": "Joe Homs",
  "license": "MIT",
  "description": "Control NextDNS status, activation, and profiles from the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "NextDNS",
    "description": "Show NextDNS status, toggle it, and switch profiles.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "profiles": [],
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
